# Copy this file to .env.local and set strong secrets.
PORT=3000

# Required: used to sign login tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Required for encrypting stored API keys.
# Keep this stable; changing it will make old encrypted keys unreadable.
USERDATA_ENC_KEY=replace-with-32-plus-random-characters

# Required on Vercel (and recommended for production).
# Postgres connection string from Vercel Postgres, Neon, or Supabase.
# Without this, accounts are stored in ephemeral /tmp on serverless and disappear.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
